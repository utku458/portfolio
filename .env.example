# Absolute origin of the deployed site, with no trailing slash.
# Everything canonical — <link rel="canonical">, Open Graph URLs, sitemap.xml —
# is derived from this value.
#
# Required for any deploy that is not Vercel. It is read when `next build`
# runs, not when the server starts, so in Docker it has to be a *build*
# argument — see the Dockerfile and the deploying section of the README. Pass it
# only at runtime and the site works while every canonical URL says localhost.
#
# On Vercel it can stay unset: the production URL comes from
# VERCEL_PROJECT_PRODUCTION_URL, which is set on previews too, so a preview's
# canonical URL points at production — the behaviour you want from a canonical.
#
# No trailing slash:
# NEXT_PUBLIC_SITE_URL=https://utkualtinay.com

# ── Contact form ────────────────────────────────────────────────────────────
# The form posts to a Server Action that sends the message through Resend
# (https://resend.com). Without a key the form validates and then tells the
# visitor to email directly, so the site is never a dead end — but nothing is
# actually delivered until this is set.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to the address in src/data/profile.ts.
# CONTACT_TO_EMAIL=altinayutku0@gmail.com

# The "from" address. Resend's shared sender works for testing; switch to an
# address on your own domain once it is verified with them.
# CONTACT_FROM_EMAIL=hello@utkualtinay.com
